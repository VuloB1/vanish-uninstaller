{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Vanish Uninstaller",
  "version": "1.2.0",
  "identifier": "app.vanish.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Vanish Uninstaller",
        "decorations": false,
        "width": 1100,
        "height": 720,
        "minWidth": 820,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": [
          "English",
          "Spanish",
          "PortugueseBR",
          "SimpChinese",
          "Japanese",
          "Korean"
        ],
        "displayLanguageSelector": false
      }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDNDQzA2QTI3NUFDNUQ2RjIKUldUeTFzVmFKMnJBUEkvbGlPR0lpcE1ZWHVxNjJSRHVTb3plNHI5c1B1YnJIcmN6c2poUUNiUm0K",
      "endpoints": [
        "https://github.com/VuloB1/vanish-uninstaller/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
